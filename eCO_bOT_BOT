#COMANDOS
@bot.event
async def on_ready():
    print(f'We have logged in as {bot.user}')

@bot.command()
async def intro(ctx):
    await ctx.send(f'Hola, soy un bot {bot.user}! Te ayudaré e informaré sobre como podemos ayudar al medio ambiente :D')
@bot.command()
async def quiz(ctx):
    count=0
    print("Hola, te haré 3 preguntas aleatorias sobre como podemos cuidar el ambiente, te diré tus aciertos y corregiré tus errores :)")
    print("EMPECEMOS >:D")
    preguntas_aleatorias = random.sample(list(preguntas.items()), 3)
    for preguntas, respuesta_correcta in preguntas_aleatorias:
        print(random.choice(preguntas))
        res=input("Cuál opción es la correcta?")
        if res == respuesta_correcta[preguntas]:
            print("CORRECTO")
            count+=1
        else:
            print("INCORRECTO")
        print("Completaste la actividad, cada día aprendemos más >:DDDDD")
